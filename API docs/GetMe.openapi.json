{
  "openapi": "3.0.0",
  "info": {
    "title": "ShotMeld API - 获取用户信息",
    "description": "获取当前用户信息的API，包含用户基本信息、照片总数和相册总数",
    "version": "1.0.0",
    "contact": {
      "name": "ShotMeld团队",
      "email": "support@shotmeld.com"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "ShotMeld API"
    }
  ],
  "paths": {
    "/auth/me": {
      "get": {
        "summary": "获取当前用户信息",
        "description": "获取当前登录用户的详细信息，包括照片总数和相册总数",
        "operationId": "getMe",
        "tags": ["认证"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取用户信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "code": 401,
                      "message": "用户未认证，请登录"
                    }
                  },
                  "invalidToken": {
                    "value": {
                      "code": 401,
                      "message": "无效的身份验证凭证"
                    }
                  },
                  "tokenExpired": {
                    "value": {
                      "code": 401,
                      "message": "身份验证已过期，请重新登录"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "username", "email", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "description": "用户ID",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "description": "用户名"
          },
          "email": {
            "type": "string",
            "description": "邮箱",
            "format": "email"
          },
          "photoCount": {
            "type": "integer",
            "description": "用户照片总数",
            "minimum": 0
          },
          "albumCount": {
            "type": "integer",
            "description": "用户相册总数",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "description": "创建时间",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "更新时间",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer",
            "description": "HTTP状态码"
          },
          "message": {
            "type": "string",
            "description": "错误信息"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token认证"
      }
    }
  }
}
