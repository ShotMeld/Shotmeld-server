{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Photos by Title",
    "description": "API for searching photos by title.",
    "version": "1.0.0"
  },
  "paths": {
    "/photos/search/title": {
      "get": {
        "summary": "根据标题搜索照片",
        "description": "通过标题关键词搜索用户的照片，支持分页和排序。",
        "tags": ["照片管理"],
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "搜索的标题关键词",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，默认为1",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页返回的记录数，默认为50，最大200",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "排序字段，可选值为'title', 'takenAt', 'createdAt', 'fileSize'",
            "schema": {
              "type": "string",
              "default": "takenAt"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "排序顺序，'asc'为升序，'desc'为降序",
            "schema": {
              "type": "string",
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回搜索结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Photo"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "符合条件的照片总数"
                    },
                    "page": {
                      "type": "integer",
                      "description": "当前页码"
                    },
                    "limit": {
                      "type": "integer",
                      "description": "每页返回的记录数"
                    },
                    "totalPages": {
                      "type": "integer",
                      "description": "总页数"
                    },
                    "searchTerm": {
                      "type": "string",
                      "description": "搜索的标题关键词"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Photo": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "照片的唯一标识符"
          },
          "title": {
            "type": "string",
            "description": "照片标题"
          },
          "description": {
            "type": "string",
            "description": "照片描述"
          },
          "url": {
            "type": "string",
            "description": "照片的URL"
          },
          "thumbnailUrl": {
            "type": "string",
            "description": "缩略图的URL"
          },
          "takenAt": {
            "type": "string",
            "format": "date-time",
            "description": "照片拍摄时间"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "照片创建时间"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "照片更新时间"
          }
        }
      }
    }
  }
}