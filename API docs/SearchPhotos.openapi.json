{
  "openapi": "3.0.0",
  "info": {
    "title": "Search Photos",
    "description": "API for comprehensively searching photos by title, tags, or location.",
    "version": "2.0.0"
  },
  "paths": {
    "/photos/search": {
      "get": {
        "summary": "综合搜索照片",
        "description": "通过关键词搜索用户的照片，可匹配标题、标签或地点，支持分页和排序。",
        "tags": ["照片管理"],
        "parameters": [
          {
            "name": "searchKey",
            "in": "query",
            "required": true,
            "description": "搜索关键词，可匹配标题、标签或地点名称",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，默认为1",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页返回的记录数，默认为50，最大200",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "排序字段，可选值为'title', 'takenAt', 'createdAt', 'fileSize'",
            "schema": {
              "type": "string",
              "default": "takenAt"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "排序顺序，'asc'为升序，'desc'为降序",
            "schema": {
              "type": "string",
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回搜索结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Photo"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "符合条件的照片总数"
                    },
                    "page": {
                      "type": "integer",
                      "description": "当前页码"
                    },
                    "limit": {
                      "type": "integer",
                      "description": "每页返回的记录数"
                    },
                    "totalPages": {
                      "type": "integer",
                      "description": "总页数"
                    },
                    "searchKey": {
                      "type": "string",
                      "description": "搜索关键词"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "错误代码，如 'SEARCH_KEY_REQUIRED'"
                    },
                    "message": {
                      "type": "string",
                      "description": "错误信息，如 '请提供搜索关键词'"
                    }
                  }
                },
                "examples": {
                  "missingParams": {
                    "value": {
                      "error": "SEARCH_KEY_REQUIRED",
                      "message": "请提供搜索关键词"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Photo": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "照片唯一标识符"
          },
          "title": {
            "type": ["string", "null"],
            "description": "照片标题"
          },
          "description": {
            "type": ["string", "null"],
            "description": "照片描述"
          },
          "filename": {
            "type": "string",
            "description": "文件名"
          },
          "fileSize": {
            "type": "number",
            "description": "文件大小（字节）"
          },
          "url": {
            "type": "string",
            "description": "照片URL"
          },
          "thumbnailUrl": {
            "type": ["string", "null"],
            "description": "缩略图URL"
          },
          "takenAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "拍摄时间"
          },
          "location": {
            "type": ["object", "null"],
            "description": "拍摄地点",
            "properties": {
              "latitude": {
                "type": "number",
                "description": "纬度"
              },
              "longitude": {
                "type": "number",
                "description": "经度"
              },
              "name": {
                "type": ["string", "null"],
                "description": "地点名称"
              }
            }
          },
          "tags": {
            "type": "array",
            "description": "照片标签",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "更新时间"
          }
        }
      }
    }
  }
}
